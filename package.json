{
	"name": "kostos-v2",
	"private": true,
	"version": "2.2.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"sync": "node scripts/sync-server.js",
		"icons": "pwa-assets-generator && node scripts/build-maskable.js",
		"screenshots": "node scripts/screenshots.js",
		"seed": "node scripts/generate-seed.js",
		"cf:dev": "wrangler dev",
		"cf:deploy": "vite build && wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260521.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"playwright": "^1.60.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.7",
		"wrangler": "^4.93.1"
	},
	"dependencies": {
		"@fontsource/instrument-serif": "^5.2.8",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"qr-scanner": "^1.4.2",
		"qrcode": "^1.5.4",
		"ws": "^8.22.0",
		"y-indexeddb": "^9.0.12",
		"yjs": "^13.6.30"
	}
}
